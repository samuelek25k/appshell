{
  "$id": "https://appshell.dev/schemas/catalog.schema.json",
  "title": "Appshell catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "apps"],
  "$defs": {
    "asset": {
      "description": "Image for store listings: an https URL, or a path relative to the catalog file.",
      "type": "string",
      "pattern": "^(https://\\S+|(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp|svg))$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "repository", "releases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
          "repository": { "type": "string", "pattern": "^https://" },
          "description": { "type": "string", "maxLength": 600 },
          "categories": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
          "icon": { "$ref": "#/$defs/asset" },
          "screenshots": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/asset" } },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "channel", "url", "sha256", "commit"],
              "properties": {
                "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
                "channel": { "enum": ["stable", "beta"] },
                "url": { "type": "string", "pattern": "^(https|file)://" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
              }
            }
          }
        }
      }
    }
  }
}
