{
  "$id": "https://appshell.dev/schemas/product.schema.json",
  "title": "Appshell product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "protocol", "dataDirectory", "package", "apps", "policy"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "protocol": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$", "not": { "enum": ["app", "file", "http", "https"] } },
    "dataDirectory": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension", "displayName"],
      "properties": {
        "extension": { "type": "string", "pattern": "^\\.[a-z0-9]+$" },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "catalog": { "description": "URL of the catalog index.json", "type": "string", "pattern": "^https://" },
    "maintainer": { "description": "Installer maintainer, Name <email>; required for Linux .deb packages.", "type": "string", "pattern": "^[^<>]+ <[^<>@\\s]+@[^<>@\\s]+>$" },
    "defaultLocale": {
      "description": "Default BCP 47 locale tag for the product, e.g. en-US.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-\\d{3})?$"
    },
    "apps": {
      "description": "Pre-installed app folders, relative to the apps root (--apps flag, default <product folder>/apps). Protected apps cannot be removed by users.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": { "path": { "type": "string" }, "protected": { "type": "boolean" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": { "enum": ["warn", "enforce"], "default": "enforce" },
        "developerMode": { "type": "boolean", "default": false },
        "allowedSources": {
          "description": "URL prefixes that catalog repositories and release downloads must start with. file:// sources need developerMode.",
          "type": "array",
          "items": { "type": "string", "pattern": "^https://" }
        },
        "channel": { "enum": ["stable", "beta"], "default": "stable" },
        "allowUserEndpoints": { "description": "Whether apps may ask the user to approve extra network addresses.", "type": "boolean", "default": true },
        "allowGuest": { "description": "Whether the shell offers a guest account.", "type": "boolean", "default": true },
        "grants": {
          "description": "Raise resource limits for apps from a named source. A grant only widens a default and is capped by the platform ceilings.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from"],
            "anyOf": [{ "required": ["storageMb"] }, { "required": ["backendIdleMinutes"] }],
            "properties": {
              "from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["bundled", "catalog"] } },
              "apps": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" } },
              "storageMb": { "type": "number", "exclusiveMinimum": 0, "maximum": 32 },
              "backendIdleMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 1440 }
            }
          }
        },
        "trustedKeys": {
          "description": "Ed25519 public keys (base64, 32 bytes). When set, every catalog install must carry a signature from one of them.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "key"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
            }
          }
        },
        "blockedApps": {
          "description": "App IDs prohibited from installation or execution under administrator governance.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
