{
  "name": "appshell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "audit": "pnpm audit --prod --audit-level=high",
    "secrets": "secretlint \"**/*\"",
    "hygiene": "node scripts/hygiene.mjs",
    "appshell": "node packages/cli/bin.js",
    "dist:win": "node scripts/build-config.mjs && electron-builder --win --publish never",
    "dist:mac": "node scripts/build-config.mjs && electron-builder --mac --publish never",
    "dist:linux": "node scripts/build-config.mjs && electron-builder --linux --publish never",
    "dist": "node scripts/build-config.mjs && electron-builder --publish never",
    "start": "electron packages/host --product products/appshell/product.json --apps ../appshell-apps",
    "prepare": "husky"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "husky": "^9.1.7",
    "secretlint": "^13.0.7",
    "typescript": "^7.0.2",
    "tar": "^7.5.22"
  }
}
